import pandas as pd
import numpy as np

pd.set_option("display.max_columns", None)
pd.set_option("display.float_format", "{:.4f}".format)

DATA_PATH = "../data/raw/taxol_resistance_dataset.csv"

df = pd.read_csv(DATA_PATH)

print("Dataset shape:", df.shape)
df.head()

expected_columns = {"Gene.symbol", "P.Value", "logFC", "Cell Line"}
assert set(df.columns) == expected_columns, "Unexpected columns detected!"

df = df.rename(columns={
    "Gene.symbol": "gene_symbol",
    "P.Value": "p_value",
    "Cell Line": "cell_line"
})

df.info()

df.isnull().sum()

missing_pct = df.isnull().mean() * 100
missing_pct

duplicates = df.duplicated().sum()
print("Number of duplicate rows:", duplicates)

# Gene duplicates per cell line (expected)
df.groupby(["gene_symbol", "cell_line"]).size().reset_index(name="count").query("count > 1")

df["cell_line"].value_counts()

df.groupby("cell_line").size().plot(
    kind="bar",
    title="Gene Counts per Cell Line",
    ylabel="Number of Genes",
    xlabel="Cell Line"
)

df["logFC"].describe()

df["logFC"].hist(bins=100)

df["p_value"].describe()

df["p_value"].hist(bins=100)

deg = df[(df["p_value"] < 0.05) & (df["logFC"].abs() > 1)]

deg.groupby("cell_line").size()

directionality = (
    df.assign(direction=np.where(df["logFC"] > 0, "Upregulated", "Downregulated"))
      .groupby(["cell_line", "direction"])
      .size()
      .unstack(fill_value=0)
)

directionality

df["gene_symbol"].nunique()

df["gene_symbol"].str.contains(" ").sum()

OUTPUT_PATH = "../data/processed/gene_expression_cleaned.csv"

df.to_csv(OUTPUT_PATH, index=False)

print(f"Cleaned dataset saved to: {OUTPUT_PATH}")

