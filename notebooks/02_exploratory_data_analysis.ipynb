import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
import seaborn as sns

sns.set(style="whitegrid")
pd.set_option("display.float_format", "{:.4f}".format)

DATA_PATH = "../data/processed/gene_expression_cleaned.csv"

df = pd.read_csv(DATA_PATH)

print("Dataset shape:", df.shape)
df.head()

df.describe()

df.groupby("cell_line")[["logFC", "p_value"]].agg(
    ["mean", "median", "std"])

plt.figure(figsize=(8, 5))
sns.histplot(df["logFC"], bins=100, kde=True)
plt.title("Global Distribution of logFC")
plt.xlabel("logFC (Resistant vs Sensitive)")
plt.ylabel("Frequency")
plt.show()

plt.figure(figsize=(10, 6))
sns.boxplot(data=df, x="cell_line", y="logFC")
plt.title("logFC Distribution by Cell Line")
plt.xlabel("Cell Line")
plt.ylabel("logFC")
plt.show()

DEG_THRESHOLD_P = 0.05
DEG_THRESHOLD_LOGFC = 1

deg = df[
    (df["p_value"] < DEG_THRESHOLD_P) &
    (df["logFC"].abs() > DEG_THRESHOLD_LOGFC)
]

deg_counts = deg.groupby("cell_line").size()
deg_counts

deg_counts.plot(
    kind="bar",
    title="Differentially Expressed Genes per Cell Line",
    ylabel="Number of DEGs",
    xlabel="Cell Line"
)
plt.show()

deg = deg.assign(
    direction=np.where(deg["logFC"] > 0, "Upregulated", "Downregulated")
)

direction_counts = (
    deg.groupby(["cell_line", "direction"])
       .size()
       .unstack(fill_value=0)
)

direction_counts

direction_counts.plot(
    kind="bar",
    stacked=True,
    figsize=(8, 6),
    title="Upregulated vs Downregulated DEGs"
)
plt.ylabel("Gene Count")
plt.show()

def volcano_plot(data, cell_line, p_thresh=0.05, logfc_thresh=1):
    subset = data[data["cell_line"] == cell_line].copy()
    subset["-log10(p_value)"] = -np.log10(subset["p_value"])
    
    plt.figure(figsize=(8, 6))
    plt.scatter(
        subset["logFC"],
        subset["-log10(p_value)"],
        c="gray",
        alpha=0.5,
        s=10
    )
    
    sig = subset[
        (subset["p_value"] < p_thresh) &
        (subset["logFC"].abs() > logfc_thresh)
    ]
    
    plt.scatter(
        sig["logFC"],
        sig["-log10(p_value)"],
        c="red",
        alpha=0.7,
        s=12
    )
    
    plt.axvline(logfc_thresh, linestyle="--", color="black")
    plt.axvline(-logfc_thresh, linestyle="--", color="black")
    plt.axhline(-np.log10(p_thresh), linestyle="--", color="black")
    
    plt.title(f"Volcano Plot — {cell_line}")
    plt.xlabel("logFC")
    plt.ylabel("-log10(p-value)")
    plt.show()

for cl in df["cell_line"].unique():
    volcano_plot(df, cl)

top_up = (
    deg[deg["direction"] == "Upregulated"]
    .sort_values("logFC", ascending=False)
    .groupby("cell_line")
    .head(10)
)

top_up[["cell_line", "gene_symbol", "logFC"]]

top_down = (
    deg[deg["direction"] == "Downregulated"]
    .sort_values("logFC")
    .groupby("cell_line")
    .head(10)
)

top_down[["cell_line", "gene_symbol", "logFC"]]

shared_genes = (
    deg.groupby("gene_symbol")["cell_line"]
       .nunique()
       .reset_index()
       .query("cell_line >= 3")
)

shared_genes.head()

print("Genes shared across ≥3 cell lines:", shared_genes.shape[0])

top_shared = shared_genes.merge(
    deg, on="gene_symbol"
).pivot_table(
    index="gene_symbol",
    columns="cell_line",
    values="logFC"
)

top_shared = top_shared.head(50)

plt.figure(figsize=(8, 12))
sns.heatmap(
    top_shared,
    cmap="coolwarm",
    center=0
)
plt.title("Top Shared Resistance Genes (logFC)")
plt.show()

