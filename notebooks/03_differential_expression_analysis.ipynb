import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
import seaborn as sns

sns.set(style="whitegrid")
pd.set_option("display.float_format", "{:.4f}".format)

DATA_PATH = "../data/processed/gene_expression_cleaned.csv"
df = pd.read_csv(DATA_PATH)

print("Dataset shape:", df.shape)
df.head()

P_THRESHOLD = 0.05
LOGFC_THRESHOLD = 1.0

print(f"P-value threshold: {P_THRESHOLD}")
print(f"logFC threshold: ±{LOGFC_THRESHOLD}")

deg = df[
    (df["p_value"] < P_THRESHOLD) &
    (df["logFC"].abs() >= LOGFC_THRESHOLD)
].copy()

print("Total DEGs:", deg.shape[0])
deg.head()

deg_counts = deg.groupby("cell_line").size().reset_index(name="deg_count")
deg_counts

plt.figure(figsize=(7,5))
sns.barplot(data=deg_counts, x="cell_line", y="deg_count")
plt.title("Number of DEGs per Cell Line")
plt.ylabel("DEG Count")
plt.xlabel("Cell Line")
plt.show()

deg["direction"] = np.where(deg["logFC"] > 0, "Upregulated", "Downregulated")

directionality = (
    deg.groupby(["cell_line", "direction"])
       .size()
       .unstack(fill_value=0)
)

directionality

directionality.plot(
    kind="bar",
    stacked=True,
    figsize=(8,6),
    title="DEG Directionality per Cell Line"
)
plt.ylabel("Gene Count")
plt.show()

deg_sets = {
    cl: set(deg.loc[deg["cell_line"] == cl, "gene_symbol"])
    for cl in deg["cell_line"].unique()
}

for cl, genes in deg_sets.items():
    print(f"{cl}: {len(genes)} DEGs")

core_genes = set.intersection(*deg_sets.values())

print("Core resistance genes (shared across all cell lines):", len(core_genes))
list(core_genes)[:10]

gene_occurrence = (
    deg.groupby("gene_symbol")["cell_line"]
       .nunique()
       .reset_index(name="cell_line_count")
)

near_core = gene_occurrence.query("cell_line_count >= 3")

print("Genes shared across ≥3 cell lines:", near_core.shape[0])
near_core.head()

specific_genes = {}

for cl in deg_sets:
    others = set.union(*(v for k, v in deg_sets.items() if k != cl))
    specific_genes[cl] = deg_sets[cl] - others
    print(f"{cl} specific genes:", len(specific_genes[cl]))

overlap_matrix = pd.DataFrame(index=deg_sets.keys(), columns=deg_sets.keys())

for cl1 in deg_sets:
    for cl2 in deg_sets:
        overlap_matrix.loc[cl1, cl2] = len(deg_sets[cl1] & deg_sets[cl2])

overlap_matrix = overlap_matrix.astype(int)
overlap_matrix

plt.figure(figsize=(6,5))
sns.heatmap(overlap_matrix, annot=True, fmt="d", cmap="Blues")
plt.title("DEG Overlap Between Cell Lines")
plt.show()

top_resistance_genes = (
    deg.merge(near_core, on="gene_symbol")
       .groupby("gene_symbol")["logFC"]
       .mean()
       .abs()
       .sort_values(ascending=False)
       .head(20)
)

top_resistance_genes

signature_matrix = deg.pivot_table(
    index="gene_symbol",
    columns="cell_line",
    values="logFC",
    aggfunc="mean"
)

signature_matrix.head()

deg.to_csv("../data/processed/differentially_expressed_genes.csv", index=False)
near_core.to_csv("../data/processed/near_core_resistance_genes.csv", index=False)
signature_matrix.to_csv("../data/processed/resistance_signature_matrix.csv")

print("Saved DEG tables and resistance signature matrix.")

