import pandas as pd
import numpy as np

from sklearn.preprocessing import StandardScaler
from sklearn.feature_selection import VarianceThreshold, SelectKBest, f_classif

pd.set_option("display.max_columns", None)
pd.set_option("display.float_format", "{:.4f}".format)

DEG_PATH = "../data/processed/differentially_expressed_genes.csv"
SIGNATURE_PATH = "../data/processed/resistance_signature_matrix.csv"

deg = pd.read_csv(DEG_PATH)
signature = pd.read_csv(SIGNATURE_PATH, index_col=0)

print("DEG shape:", deg.shape)
print("Signature matrix shape:", signature.shape)

deg["resistance_direction"] = (deg["logFC"] > 0).astype(int)

deg[["gene_symbol", "cell_line", "logFC", "resistance_direction"]].head()

X = signature.T.copy()   # samples × genes
X.index.name = "cell_line"

print("Feature matrix shape:", X.shape)
X.head()

missing_pct = X.isnull().mean().mean() * 100
print(f"Overall missing value percentage: {missing_pct:.2f}%")

X_filled = X.fillna(0)

cell_line_labels = {
    "BAS": 1,
    "HS578T": 1,
    "MCF7": 1,
    "MDA": 1
}

y = X_filled.index.map(cell_line_labels).values

print("Target vector:", y)

scaler = StandardScaler()
X_scaled = pd.DataFrame(
    scaler.fit_transform(X_filled),
    index=X_filled.index,
    columns=X_filled.columns
)

X_scaled.head()

var_thresh = VarianceThreshold(threshold=0.01)
X_var = var_thresh.fit_transform(X_scaled)

selected_features_var = X_scaled.columns[var_thresh.get_support()]

X_var = pd.DataFrame(
    X_var,
    index=X_scaled.index,
    columns=selected_features_var
)

print("Features after variance filtering:", X_var.shape[1])

K = min(100, X_var.shape[1])

selector = SelectKBest(score_func=f_classif, k=K)
X_kbest = selector.fit_transform(X_var, y)

selected_features_kbest = X_var.columns[selector.get_support()]

X_kbest = pd.DataFrame(
    X_kbest,
    index=X_var.index,
    columns=selected_features_kbest
)

print("Final selected features:", X_kbest.shape[1])
X_kbest.head()

selected_features_kbest.tolist()[:20]

X_filled.to_csv("../data/processed/features_full.csv")
X_var.to_csv("../data/processed/features_variance_filtered.csv")
X_kbest.to_csv("../data/processed/features_selected.csv")

print("Saved all feature engineering outputs.")

summary = pd.DataFrame({
    "Stage": [
        "Original features",
        "After missing value handling",
        "After variance filtering",
        "After univariate selection"
    ],
    "Feature Count": [
        X.shape[1],
        X_filled.shape[1],
        X_var.shape[1],
        X_kbest.shape[1]
    ]
})

summary

