import pandas as pd
import numpy as np

from sklearn.model_selection import LeaveOneOut, cross_val_score
from sklearn.linear_model import LogisticRegression
from sklearn.ensemble import RandomForestClassifier
from sklearn.metrics import accuracy_score, roc_auc_score

from xgboost import XGBClassifier
from catboost import CatBoostClassifier

import warnings
warnings.filterwarnings("ignore")

FEATURE_PATH = "../data/processed/features_selected.csv"

X = pd.read_csv(FEATURE_PATH, index_col=0)

print("Feature matrix shape:", X.shape)
X.head()

y = np.ones(X.shape[0])

print("Target vector:", y)

cv = LeaveOneOut()

logreg = LogisticRegression(max_iter=1000)

logreg_scores = cross_val_score(
    logreg, X, y, cv=cv, scoring="accuracy"
)

print("Logistic Regression LOOCV Accuracy:", logreg_scores.mean())

rf = RandomForestClassifier(
    n_estimators=200,
    random_state=42
)

rf_scores = cross_val_score(
    rf, X, y, cv=cv, scoring="accuracy"
)

print("Random Forest LOOCV Accuracy:", rf_scores.mean())

xgb = XGBClassifier(
    n_estimators=200,
    learning_rate=0.05,
    max_depth=3,
    subsample=0.8,
    colsample_bytree=0.8,
    eval_metric="logloss",
    random_state=42
)

xgb_scores = cross_val_score(
    xgb, X, y, cv=cv, scoring="accuracy"
)

print("XGBoost LOOCV Accuracy:", xgb_scores.mean())

cat = CatBoostClassifier(
    iterations=300,
    learning_rate=0.05,
    depth=4,
    verbose=False,
    random_seed=42
)

cat_scores = cross_val_score(
    cat, X, y, cv=cv, scoring="accuracy"
)

print("CatBoost LOOCV Accuracy:", cat_scores.mean())

results = pd.DataFrame({
    "Model": [
        "Logistic Regression",
        "Random Forest",
        "XGBoost",
        "CatBoost"
    ],
    "LOOCV Accuracy": [
        logreg_scores.mean(),
        rf_scores.mean(),
        xgb_scores.mean(),
        cat_scores.mean()
    ]
})

results

logreg.fit(X, y)
rf.fit(X, y)
xgb.fit(X, y)
cat.fit(X, y)

print("All models trained on full dataset.")

import joblib

joblib.dump(logreg, "../data/processed/logistic_regression_model.pkl")
joblib.dump(rf, "../data/processed/random_forest_model.pkl")
joblib.dump(xgb, "../data/processed/xgboost_model.pkl")
joblib.dump(cat, "../data/processed/catboost_model.pkl")

print("Models saved successfully.")

results.sort_values("LOOCV Accuracy", ascending=False)

