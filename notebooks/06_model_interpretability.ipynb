import pandas as pd
import numpy as np

import shap
import joblib
import matplotlib.pyplot as plt
import seaborn as sns

sns.set(style="whitegrid")
pd.set_option("display.float_format", "{:.4f}".format)

shap.initjs()

FEATURE_PATH = "../data/processed/features_selected.csv"
X = pd.read_csv(FEATURE_PATH, index_col=0)

print("Feature matrix shape:", X.shape)
X.head()

rf = joblib.load("../data/processed/random_forest_model.pkl")
xgb = joblib.load("../data/processed/xgboost_model.pkl")
cat = joblib.load("../data/processed/catboost_model.pkl")

print("Models loaded successfully.")

rf_importance = pd.DataFrame({
    "gene": X.columns,
    "importance": rf.feature_importances_
}).sort_values("importance", ascending=False)

rf_importance.head(15)

plt.figure(figsize=(8,6))
sns.barplot(
    data=rf_importance.head(20),
    y="gene",
    x="importance"
)
plt.title("Top 20 Random Forest Feature Importances")
plt.xlabel("Importance Score")
plt.ylabel("Gene")
plt.show()

xgb_importance = pd.DataFrame({
    "gene": X.columns,
    "importance": xgb.feature_importances_
}).sort_values("importance", ascending=False)

xgb_importance.head(15)

plt.figure(figsize=(8,6))
sns.barplot(
    data=xgb_importance.head(20),
    y="gene",
    x="importance"
)
plt.title("Top 20 XGBoost Feature Importances")
plt.xlabel("Importance Score")
plt.ylabel("Gene")
plt.show()

cat_importance = pd.DataFrame({
    "gene": X.columns,
    "importance": cat.get_feature_importance()
}).sort_values("importance", ascending=False)

cat_importance.head(15)

plt.figure(figsize=(8,6))
sns.barplot(
    data=cat_importance.head(20),
    y="gene",
    x="importance"
)
plt.title("Top 20 CatBoost Feature Importances")
plt.xlabel("Importance Score")
plt.ylabel("Gene")
plt.show()

top_rf = set(rf_importance.head(20)["gene"])
top_xgb = set(xgb_importance.head(20)["gene"])
top_cat = set(cat_importance.head(20)["gene"])

consensus_genes = top_rf & top_xgb & top_cat

print("Consensus resistance genes across all models:")
list(consensus_genes)

explainer = shap.TreeExplainer(xgb)
shap_values = explainer.shap_values(X)

shap.summary_plot(
    shap_values,
    X,
    plot_type="bar",
    show=False
)
plt.title("SHAP Global Feature Importance (XGBoost)")
plt.show()

shap.summary_plot(
    shap_values,
    X,
    show=False
)
plt.show()

top_gene = xgb_importance.iloc[0]["gene"]

shap.dependence_plot(
    top_gene,
    shap_values,
    X,
    show=False
)
plt.show()

mean_shap = np.abs(shap_values).mean(axis=0)

shap_importance = pd.DataFrame({
    "gene": X.columns,
    "mean_abs_shap": mean_shap
}).sort_values("mean_abs_shap", ascending=False)

shap_importance.head(20)

rf_importance.to_csv("../data/processed/rf_feature_importance.csv", index=False)
xgb_importance.to_csv("../data/processed/xgb_feature_importance.csv", index=False)
cat_importance.to_csv("../data/processed/cat_feature_importance.csv", index=False)
shap_importance.to_csv("../data/processed/shap_feature_importance.csv", index=False)

print("Interpretability outputs saved.")
