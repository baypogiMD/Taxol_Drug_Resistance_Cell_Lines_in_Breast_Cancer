import pandas as pd
import numpy as np

import matplotlib.pyplot as plt
import seaborn as sns

sns.set(style="whitegrid")
pd.set_option("display.float_format", "{:.4f}".format)

deg = pd.read_csv("../data/processed/differentially_expressed_genes.csv")
near_core = pd.read_csv("../data/processed/near_core_resistance_genes.csv")

rf_imp = pd.read_csv("../data/processed/rf_feature_importance.csv")
xgb_imp = pd.read_csv("../data/processed/xgb_feature_importance.csv")
cat_imp = pd.read_csv("../data/processed/cat_feature_importance.csv")
shap_imp = pd.read_csv("../data/processed/shap_feature_importance.csv")

print("Loaded all analytical outputs.")

top_rf = set(rf_imp.head(20)["gene"])
top_xgb = set(xgb_imp.head(20)["gene"])
top_cat = set(cat_imp.head(20)["gene"])
top_shap = set(shap_imp.head(20)["gene"])

consensus_genes = list(top_rf & top_xgb & top_cat & top_shap)

print("High-confidence resistance genes:")
consensus_genes

consensus_deg = deg[deg["gene_symbol"].isin(consensus_genes)]

directionality = (
    consensus_deg.assign(
        direction=np.where(consensus_deg["logFC"] > 0, "Upregulated", "Downregulated")
    )
    .groupby(["gene_symbol", "direction"])
    .size()
    .unstack(fill_value=0)
)

directionality

cell_line_consistency = (
    consensus_deg.groupby("gene_symbol")["cell_line"]
    .nunique()
    .sort_values(ascending=False)
)

cell_line_consistency

biological_themes = {
    "EMT & Cell Plasticity": ["CDH11", "INHBA", "PDPN", "CXCR4"],
    "Extracellular Matrix Remodeling": ["SERPINB2", "MGP", "COL-related"],
    "Immune / Inflammatory Modulation": ["CFH", "CXCR4"],
    "Drug Metabolism & Stress Response": ["CYP24A1"],
    "Coagulation / Survival Signaling": ["TFPI"]
}

themes_df = pd.DataFrame([
    {"Theme": theme, "Genes": ", ".join(genes)}
    for theme, genes in biological_themes.items()
])

themes_df

mechanisms = pd.DataFrame({
    "Mechanism": [
        "Phenotypic Plasticity (EMT)",
        "Tumor Microenvironment Remodeling",
        "Inflammatory Survival Signaling",
        "Drug Detoxification / Metabolism",
        "Non-Mitotic Resistance Pathways"
    ],
    "Evidence": [
        "Upregulation of EMT-associated genes across resistant lines",
        "ECM and adhesion-related genes enriched in resistance",
        "Immune-modulating genes repeatedly selected by ML",
        "Metabolic genes linked to drug inactivation identified",
        "Resistance signatures not centered on tubulin genes"
    ]
})

mechanisms

tubulin_related = deg[deg["gene_symbol"].str.contains("TUB", case=False, na=False)]

tubulin_related.shape

biomarkers = pd.DataFrame({
    "Gene": consensus_genes,
    "Rationale": [
        "Appears across all ML models and cell lines",
        "High effect size and consistent directionality",
        "Linked to EMT / microenvironment remodeling",
        "Known involvement in cancer drug resistance",
        "Potential blood or tissue biomarker"
    ][:len(consensus_genes)]
})

biomarkers

